# No dependency install scripts, in Docker and on the host: nothing here needs
# them (better-sqlite3 and sqlite-vec ship prebuilt binaries in their npm
# packages), and they would run arbitrary package code with your permissions.
ignore-scripts=true
# Only resolve versions published at least 14 days ago. Most compromised
# releases are caught and pulled within days. npm 11.10+.
min-release-age=14
