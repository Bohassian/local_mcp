{
  "name": "local-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "ingest": "tsx src/docs/ingest/ingest.ts",
    "fetch-docs": "tsx src/docs/ingest/fetch-devdocs.ts",
    "eval": "tsx src/docs/eval/eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.7.0",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  }
}
