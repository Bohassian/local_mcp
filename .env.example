# Copy to .env. Read by docker compose and by the host-side npm scripts.

# Ollama runs on the CPU by default. To use a GPU, and/or to serve the home
# network (see below), list the extra files here, separated by colons:
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.amd.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml:docker-compose.lan.yml

# Bearer token every MCP client must send, from this machine or the network.
# Required; the server won't start without it. Generate with:
#   openssl rand -hex 32
MCP_TOKEN=

# Serving the home network (needs docker-compose.lan.yml in COMPOSE_FILE).
# MCP_LAN_IP: this machine's LAN address; the server is published there as
#   well as on 127.0.0.1. Give the machine a fixed address (DHCP reservation).
# MCP_ALLOWED_HOSTS: names clients use in their URL, comma-separated
#   (hostname, hostname.local, the IP). Anything else is refused.
# MCP_LAN_IP=192.168.1.50
# MCP_ALLOWED_HOSTS=gpubox,gpubox.local,192.168.1.50

# Where the host-side scripts reach Ollama. (The server in Docker uses
# http://ollama:11434; see docker-compose.yml.)
EMBED_URL=http://localhost:11434

# Host ports. MCP is on 127.0.0.1 (plus MCP_LAN_IP if enabled); Ollama is on
# 127.0.0.1 only.
MCP_PORT=3939
OLLAMA_PORT=11434

# The user the server runs as. Must match the host user that runs the
# scripts, so both can write data/docs.db. (`id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000
